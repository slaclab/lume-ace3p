reset 

journal off

import acis "SRFCell3mmThick.sat"
del body 2
compress ids
##vacuum only

volume all scheme Tetmesh

block 1 vol 1

block all element type tetra10

vol all sizing function skeleton scale 3 min_size 1.0 max_size 6 max_gradient 1.1

mesh volume all

# BCs: vacuum surfaces 
##sym. plane 
sideset 1 surface 4

##disk planes
sideset 2 surface 7
sideset 3 surface 2

##outer wall -> connect to shell 
sideset 6 surface 1 3 5 6 8

##mm -> m
transform mesh output scale 0.001

export genesis "SRFCellVacuum.gen" block 1 overwrite

quality vol all distortion high 0.0 draw mesh
