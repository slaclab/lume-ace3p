// T3P input for the power-balance example, from the ACE3P tutorial t3p/SIBC.
//
// A Gaussian pulse is launched into a coaxial line whose centre wire carries a
// thin lossy dielectric coating. THREE Power monitors measure where the energy
// goes -- in at reference surface 4, out at 5, dissipated on the coated wire at
// 3 -- so one run gives the whole balance.
//
// There is deliberately NO WakeField monitor: this is a pulse-propagation run,
// not a wake calculation, so the result table is indexed by time rather than by
// the wake coordinate s.

CheckPoint:
{
  Action: restart
  Ntimesteps: 500
}

ModelInfo: {

  File: test-sibc.ncdf

  BoundaryCondition: {
    Electric: 6
    Magnetic: 1 2
    Impedance: 3   //wire
    Absorbing: 4 5 //ports
  }

  SurfaceMaterial: {
    ReferenceNumber: 3
    Sigma: 5.8e7
    Frequency: 5e9

    Coating: {
      Type: ThinLossyDielectric
      Epsilon: 56
      Sigma: 12
      Thickness: 1.e-3
    }
  }
}

FiniteElement:
{
  Order: 0
  CurvedSurfaces: on
}

PRegion:
{
  Type: AutomaticMovingWindow
  Object: Pulse
  StartPoint: 0.01 0.05 -0.5
  Direction: 0 0 1
  ExcitationPort: 4
  Order: 2
  Back:  0.1
  Front: 0.1
  StructureEnd: 0.5
}

Loading:
{
 Type: PortModeLoading

 ScalingFactor: 1.0

 Port:  {
   ReferenceNumber: 4   // port is at reference surface 4
   SymmetricFactor: 4
   NumberOfModes: 1
 }

 Excitation:  {
    Power: 1.
    Pulse: {
      Type: Gaussian
      Frequency: 5e9
      Bandwidth: 2e9
      DB: 30     // cutof in dB of the Gaussian from the peak value
      T0: 2.82   // No. of sigma
      Phase: 0   //phase for the sin oscillation at the mean frequency
    }
 }
}

TimeStepping:
{
  MaximumTime: 1.0e-8
  DT: 10.e-12
}

// Field snapshots for ParaView. Delete this block to save disk -- the power
// balance does not depend on it. See the README.
Monitor:
{
  Type: Volume
  Name: field
  TimeStart: 0
  TimeEnd:   1.0e-8
  TimeStep:  0.5e-9
}

// The three Power monitors. Each writes <Name>.out under
// t3p_results/OUTPUT/: two columns, time [s] and power [W], no header row.
// 'Name' is what an output_parameters 'monitor:' key refers to.
Monitor: {
   Type: Power
   ReferenceNumber: 4     //which reference surface to monitor
   Name: inputPower
}

Monitor: {
   Type: Power
   ReferenceNumber: 5     //which reference surface to monitor
   Name: outputPower
}

Monitor: {
   Type: Power
   ReferenceNumber: 3     //which reference surface to monitor
   Name: wallossPower
}

LinearSolver: {
        Solver:              CG
}

//END
